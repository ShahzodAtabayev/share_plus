# NOTE: when .pubignore exists, pub ignores .gitignore in this directory,
# so all rules from .gitignore are repeated here.

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# IntelliJ / Android Studio / VS Code
*.iml
*.ipr
*.iws
.idea/
.vscode/

# Flutter/Dart/Pub related
# Libraries should not include pubspec.lock, per https://dart.dev/guides/libraries/private-files#pubspeclock.
pubspec.lock
**/doc/api/
.dart_tool/
build/
devtools_options.yaml
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/

# Secrets / local environment (never commit)
.env
.env.*
*.env
.fvm/
.claude/settings.local.json
*.p12
*.mobileprovision
*.pem

# Android
**/android/**/gradle-wrapper.jar
.gradle/
.kotlin/
.cxx/
.externalNativeBuild/
**/android/captures/
**/android/gradlew
**/android/gradlew.bat
**/android/local.properties
**/android/**/GeneratedPluginRegistrant.java
**/android/key.properties
*.jks
*.keystore

# iOS / macOS
**/ios/**/*.mode1v3
**/ios/**/*.mode2v3
**/ios/**/*.moved-aside
**/ios/**/*.pbxuser
**/ios/**/*.perspectivev3
**/ios/**/*sync/
**/ios/**/.sconsign.dblite
**/ios/**/.tags*
**/ios/**/.vagrant/
**/ios/**/DerivedData/
**/ios/**/Icon?
**/ios/**/Pods/
**/ios/**/.symlinks/
**/ios/**/profile
**/ios/**/xcuserdata
*.xcuserstate
**/ios/.generated/
**/ios/Flutter/.last_build_id
**/ios/Flutter/App.framework
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/ephemeral/
**/ios/Flutter/app.flx
**/ios/Flutter/app.zip
**/ios/Flutter/flutter_assets/
**/ios/Flutter/flutter_export_environment.sh
**/ios/ServiceDefinitions.json
**/ios/Runner/GeneratedPluginRegistrant.*
**/ios/Podfile.lock
**/ios/.build/
**/ios/.swiftpm/

**/macos/Flutter/ephemeral/
**/macos/Flutter/GeneratedPluginRegistrant.swift
**/macos/**/Pods/
**/macos/**/xcuserdata
**/macos/Podfile.lock
**/macos/.build/
**/macos/.swiftpm/

# Linux / Windows
**/linux/flutter/ephemeral/
**/linux/flutter/generated_plugin_registrant.*
**/linux/flutter/generated_plugins.cmake
**/windows/flutter/ephemeral/
**/windows/flutter/generated_plugin_registrant.*
**/windows/flutter/generated_plugins.cmake

# Web
example/web/flutter_service_worker.js

# Coverage
coverage/

# Not needed in the published package
.git/
.github/
.gitignore
.pubignore
.claude/
analysis_options.yaml
**/test/**/*.mocks.dart
example/ios/Podfile
example/macos/Podfile
